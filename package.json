{
  "name": "andamio-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npx tsx scripts/check-doc-headings.ts && npx tsx scripts/check-contract-manifest.ts && npx tsx scripts/check-treasury-reference.ts && npx tsx scripts/check-validators-manifest.ts && npx tsx scripts/check-orphan-routes.ts",
    "build": "next build",
    "dev": "next dev --turbo",
    "start": "next start",
    "docs-headings": "npx tsx scripts/check-doc-headings.ts",
    "docs-headings:fix": "npx tsx scripts/check-doc-headings.ts --fix",
    "docs-manifest": "npx tsx scripts/check-contract-manifest.ts",
    "docs-treasury": "npx tsx scripts/check-treasury-reference.ts",
    "docs-orphans": "npx tsx scripts/check-orphan-routes.ts",
    "docs-coverage": "npx tsx scripts/docs-coverage-check.ts",
    "docs-drift": ".claude/skills/audit-docs/detect-drift.sh",
    "docs-validators": "node scripts/generate-validators.mjs",
    "docs-validators:check": "npx tsx scripts/check-validators-manifest.ts"
  },
  "dependencies": {
    "@content-collections/core": "^0.14.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@emotion/server": "^11.11.0",
    "@fumadocs/content-collections": "^1.2.7",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@xyflow/react": "^12.7.1",
    "fs": "^0.0.1-security",
    "fumadocs-core": "15.4.1",
    "fumadocs-ui": "15.4.1",
    "geist": "^1.7.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.6.0",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^3.4.2",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "$postcss",
    "mdx-bundler": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^8",
    "eslint-config-next": "15.3.2",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
