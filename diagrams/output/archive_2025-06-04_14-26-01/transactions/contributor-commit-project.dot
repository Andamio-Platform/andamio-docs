digraph ContributorCommitProjectTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_contributor_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Contributor Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 contributorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_project_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project State UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributors: contributor_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_policy: treasury_policy_id</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: open_for_contributors</FONT></TD></TR>
        </TABLE>
    >];
    input_contributor_info [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Contributor Info UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 contributorToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">alias: contributor_alias</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">active_projects: project_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">reputation_score: score</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectInstance: (irt, project_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectPolicy: (prt, project_policy)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributorPolicy: contributor_policy_id</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_project_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>ProjectInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_state_cs: projectStateTokens[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_config: treasury_config</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: project_creator_policy</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_treasury_ref [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Treasury Reference UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryRefToken</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">reward_structure: reward_config</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_schedule: schedule_data</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">total_budget: budget_amount</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction/Operation node
    commit_project_operation [label="commit to
project", shape=box, style="rounded, filled", fillcolor="#ffffff", color="#00796b", fontsize=12, penwidth=3, width=2, height=7];

    // Output UTxO nodes
    output_project_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Project State</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributors: updated_contributor_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_policy: treasury_policy_id</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: active_with_contributors</FONT></TD></TR>
        </TABLE>
    >];
    output_contributor_info [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Contributor Info</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 contributorToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">alias: contributor_alias</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">active_projects: updated_project_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">reputation_score: updated_score</FONT></TD></TR>
        </TABLE>
    >];
    output_contributor_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Contributor Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 contributorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">2.0 ADA</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    project_state_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Commit Project</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributorAlias</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">commitmentLevel</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">estimatedHours</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    contributor_info_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Add Project</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectId</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">role</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_contributor_wallet; input_project_state; input_contributor_info; input_global_data; input_project_instance; input_treasury_ref;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_contributor_wallet -> input_project_state [style=invis, weight=10];
    input_project_state -> input_contributor_info [style=invis, weight=10];
    input_contributor_info -> input_global_data [style=invis, weight=10];
    input_global_data -> input_project_instance [style=invis, weight=10];
    input_project_instance -> input_treasury_ref [style=invis, weight=10];
    {rank=same; project_state_redeemer; contributor_info_redeemer;}
    {rank=same; commit_project_operation;}
    {rank=max; output_project_state; output_contributor_info; output_contributor_wallet;}
    // Maintain output order from YAML
    output_project_state -> output_contributor_info [style=invis, weight=10];
    output_contributor_info -> output_contributor_wallet [style=invis, weight=10];

    // Connections
    input_contributor_wallet -> commit_project_operation [arrowsize="0.6"];
    input_project_state -> project_state_redeemer [dir="none"];
    project_state_redeemer -> commit_project_operation [arrowsize="0.6"];
    input_contributor_info -> contributor_info_redeemer [dir="none"];
    contributor_info_redeemer -> commit_project_operation [arrowsize="0.6"];
    input_global_data -> commit_project_operation [arrowsize="0.6"];
    input_project_instance -> commit_project_operation [arrowsize="0.6"];
    input_treasury_ref -> commit_project_operation [arrowsize="0.6"];
    commit_project_operation -> output_project_state [arrowsize="0.6"];
    commit_project_operation -> output_contributor_info [arrowsize="0.6"];
    commit_project_operation -> output_contributor_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, contributorNFT";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}