digraph ProjectCreatorManageTreasuryTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">10.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_treasury_utxo [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Treasury UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryToken</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1000.0 ADA</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">500 rewardTokens</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">total_funds: treasury_balance</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">allocated_rewards: reward_allocation[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_schedule: schedule_data</FONT></TD></TR>
        </TABLE>
    >];
    input_admin_signature [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Instance Admin UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 instanceAdminNFT</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">admin_permissions: permission_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">instance_config: config_data</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasuryPolicy: treasury_policy_config</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectInstance: (irt, project_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">adminConfig: admin_requirements</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_project_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>ProjectInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_config: treasury_parameters</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: project_creator_policy</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">reward_structure: reward_config</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_fee_config [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Fee Configuration UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 feeConfigToken</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_fee_rate: fee_percentage</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">min_transaction_fee: min_fee</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">admin_fee_share: admin_percentage</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction/Operation node
    manage_treasury_operation [label="manage treasury
funds", shape=box, style="rounded, filled", fillcolor="#ffffff", color="#00796b", fontsize=12, penwidth=3, width=2, height=7];

    // Output UTxO nodes
    output_treasury_utxo [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Treasury UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryToken</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">950.0 ADA</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">450 rewardTokens</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">total_funds: updated_treasury_balance</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">allocated_rewards: updated_reward_allocation[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_schedule: updated_schedule_data</FONT></TD></TR>
        </TABLE>
    >];
    output_reward_payments [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Contributor Rewards</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">50 rewardTokens</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">50.0 ADA</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">recipients: contributor_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_round: payment_cycle_id</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_phase: completion_milestone</FONT></TD></TR>
        </TABLE>
    >];
    output_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5.5 ADA</FONT></TD></TR>
        </TABLE>
    >];
    output_admin_utxo [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Instance Admin UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 instanceAdminNFT</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">admin_permissions: permission_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">instance_config: config_data</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">last_approval: treasury_operation_hash</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    treasury_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Manage Treasury</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">operation_type</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">amount</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">recipient_list[]</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    admin_approval_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Admin Approval</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">approve_treasury_op</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">operation_hash</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_creator_wallet; input_treasury_utxo; input_admin_signature; input_global_data; input_project_instance; input_fee_config;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_creator_wallet -> input_treasury_utxo [style=invis, weight=10];
    input_treasury_utxo -> input_admin_signature [style=invis, weight=10];
    input_admin_signature -> input_global_data [style=invis, weight=10];
    input_global_data -> input_project_instance [style=invis, weight=10];
    input_project_instance -> input_fee_config [style=invis, weight=10];
    {rank=same; treasury_redeemer; admin_approval_redeemer;}
    {rank=same; manage_treasury_operation;}
    {rank=max; output_treasury_utxo; output_reward_payments; output_creator_wallet; output_admin_utxo;}
    // Maintain output order from YAML
    output_treasury_utxo -> output_reward_payments [style=invis, weight=10];
    output_reward_payments -> output_creator_wallet [style=invis, weight=10];
    output_creator_wallet -> output_admin_utxo [style=invis, weight=10];

    // Connections
    input_creator_wallet -> manage_treasury_operation [arrowsize="0.6"];
    input_treasury_utxo -> treasury_redeemer [dir="none"];
    treasury_redeemer -> manage_treasury_operation [arrowsize="0.6"];
    input_admin_signature -> admin_approval_redeemer [dir="none"];
    admin_approval_redeemer -> manage_treasury_operation [arrowsize="0.6"];
    input_global_data -> manage_treasury_operation [arrowsize="0.6"];
    input_project_instance -> manage_treasury_operation [arrowsize="0.6"];
    input_fee_config -> manage_treasury_operation [arrowsize="0.6"];
    manage_treasury_operation -> output_treasury_utxo [arrowsize="0.6"];
    manage_treasury_operation -> output_reward_payments [arrowsize="0.6"];
    manage_treasury_operation -> output_creator_wallet [arrowsize="0.6"];
    manage_treasury_operation -> output_admin_utxo [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, projectCreatorNFT, treasuryToken";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}