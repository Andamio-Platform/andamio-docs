digraph AccessTokenMintTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_user_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>UserState UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">Global_State</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">placeholder token</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">user_info: string</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">access_level: string</FONT></TD></TR>
        </TABLE>
    >];
    input_user_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>User Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5000000 lovelace</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_index [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Index UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 reference token</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">indexData: index</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasuryAddr: string</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasuryDatum: string</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">feeValue: string[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction node with embedded mint policy
    mint_operation [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#e8f5e8">
            <TR><TD ALIGN="center"><B><FONT POINT-SIZE="16">mint access
token</FONT></B></TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
            <TR><TD>
                <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#6A5ACD">
                    <TR><TD ALIGN="left" BGCOLOR="#f0f0ff"><B>AccessTokenMint</B></TD></TR>
                    <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">1 access_token</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">Mint Access Token</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Params:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">alias</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">userInfo</FONT></TD></TR>
                </TABLE>
            </TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
            <TR><TD>
                <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#FF8C00">
                    <TR><TD ALIGN="left" BGCOLOR="#fff0e0"><B>Init Global State Observer</B></TD></TR>
                    <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">Init_Global_State_Observer</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">(string, user_info)</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Params:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">alias</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">userInfo</FONT></TD></TR>
                </TABLE>
            </TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
        </TABLE>
    >, shape=box, style="filled", fillcolor="#e8f5e8", color="#00796b", fontname="Arial", fontsize=10, penwidth=3, margin="0.2,0.2"];

    // Output UTxO nodes
    output_access_token [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Access Token</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 access_token</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">access_level: string</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">expiry: timestamp</FONT></TD></TR>
        </TABLE>
    >];
    output_user_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>UserState UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">updated user state</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">user_info: string</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">access_tokens: token_list[]</FONT></TD></TR>
        </TABLE>
    >];
    output_user_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>User Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">remaining ada</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    user_state_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>GlobalStateAction.AddTokenInformation</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">action_param</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_user_state; input_user_wallet; input_index;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_user_state -> input_user_wallet [style=invis, weight=10];
    input_user_wallet -> input_index [style=invis, weight=10];
    {rank=same; user_state_redeemer;}
    {rank=same; mint_operation;}
    {rank=max; output_access_token; output_user_state; output_user_wallet;}
    // Maintain output order from YAML
    output_access_token -> output_user_state [style=invis, weight=10];
    output_user_state -> output_user_wallet [style=invis, weight=10];

    // Connections
    input_user_state -> user_state_redeemer [dir="none"];
    user_state_redeemer -> mint_operation [arrowsize="0.6"];
    input_user_wallet -> mint_operation [arrowsize="0.6"];
    input_index -> mint_operation [arrowsize="0.6"];
    mint_operation -> output_access_token [arrowsize="0.6", color="#6A5ACD", penwidth="2"];
    mint_operation -> output_user_state [arrowsize="0.6"];
    mint_operation -> output_user_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: userStateToken";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}