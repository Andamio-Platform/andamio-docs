digraph StudentCommitToAssignmentTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_student_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Student Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">222at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_course_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Course State UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_state_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 localStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">assignments: assignment_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">ls_cs: course_state_cs</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">at_cs: access_token_cs</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">alias: student_alias</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">courseInstance: (irt, course_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">coursePolicy: (prt, course_policy)[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_course_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>CourseInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">ls_cs: localStateTokens[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_nft_cs: course_nft_cs</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">modules: module_list[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_module_ref [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Module Reference UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 moduleToken</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">module_info: module_data</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">assignments: assignment_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: creator_policy_id</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction/Operation node
    commit_operation [label="commit to
assignment", shape=box, style="rounded, filled", fillcolor="#ffffff", color="#00796b", fontsize=12, penwidth=3, width=2, height=6];

    // Output UTxO nodes
    output_course_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Course State</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_state_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 localStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">assignments: updated_assignment_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">ls_cs: course_state_cs</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">at_cs: access_token_cs</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">alias: student_alias</FONT></TD></TR>
        </TABLE>
    >];
    output_student_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Student Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">222at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">2.5 ADA</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    course_state_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Commit Assignment</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">moduleIndex</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">assignmentIndex</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">alias</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_student_wallet; input_course_state; input_global_data; input_course_instance; input_module_ref;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_student_wallet -> input_course_state [style=invis, weight=10];
    input_course_state -> input_global_data [style=invis, weight=10];
    input_global_data -> input_course_instance [style=invis, weight=10];
    input_course_instance -> input_module_ref [style=invis, weight=10];
    {rank=same; course_state_redeemer;}
    {rank=same; commit_operation;}
    {rank=max; output_course_state; output_student_wallet;}
    // Maintain output order from YAML
    output_course_state -> output_student_wallet [style=invis, weight=10];

    // Connections
    input_student_wallet -> commit_operation [arrowsize="0.6"];
    input_course_state -> course_state_redeemer [dir="none"];
    course_state_redeemer -> commit_operation [arrowsize="0.6"];
    input_global_data -> commit_operation [arrowsize="0.6"];
    input_course_instance -> commit_operation [arrowsize="0.6"];
    input_module_ref -> commit_operation [arrowsize="0.6"];
    commit_operation -> output_course_state [arrowsize="0.6"];
    commit_operation -> output_student_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, 222at";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}