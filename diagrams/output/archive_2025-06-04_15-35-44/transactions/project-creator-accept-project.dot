digraph ProjectCreatorAcceptProjectTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_project_proposal [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Proposal UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 proposalToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributor_alias: contributor_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">proposal_data: project_proposal_content</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: submitted</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">estimated_timeline: timeline_data</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectInstance: (irt, project_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectPolicy: (prt, project_policy)[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_project_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>ProjectInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_config: treasury_parameters</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: project_creator_policy</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributor_requirements: requirements_list[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction node with embedded mint policy
    accept_project_operation [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#e8f5e8">
            <TR><TD ALIGN="center"><B><FONT POINT-SIZE="16">accept project
proposal</FONT></B></TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
            <TR><TD>
                <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#6A5ACD">
                    <TR><TD ALIGN="left" BGCOLOR="#f0f0ff"><B>ActiveProjectMint</B></TD></TR>
                    <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">1 activeProjectToken</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">Mint Active Project Token</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Params:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">contributor_alias</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">acceptance_terms</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">project_creator_signature</FONT></TD></TR>
                </TABLE>
            </TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
        </TABLE>
    >, shape=box, style="filled", fillcolor="#e8f5e8", color="#00796b", fontname="Arial", fontsize=10, penwidth=3, margin="0.2,0.2"];

    // Output UTxO nodes
    output_active_project [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Active Project UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 activeProjectToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributor_alias: contributor_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_data: accepted_project_content</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: active</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_terms: accepted_payment_structure</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">milestones: milestone_schedule</FONT></TD></TR>
        </TABLE>
    >];
    output_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">2.0 ADA</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    proposal_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>TreasuryAction.ManageTreasury</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">acceptance_terms</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_structure</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">milestone_schedule</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_creator_wallet; input_project_proposal; input_global_data; input_project_instance;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_creator_wallet -> input_project_proposal [style=invis, weight=10];
    input_project_proposal -> input_global_data [style=invis, weight=10];
    input_global_data -> input_project_instance [style=invis, weight=10];
    {rank=same; proposal_redeemer;}
    {rank=same; accept_project_operation;}
    {rank=max; output_active_project; output_creator_wallet;}
    // Maintain output order from YAML
    output_active_project -> output_creator_wallet [style=invis, weight=10];

    // Connections
    input_creator_wallet -> accept_project_operation [arrowsize="0.6"];
    input_project_proposal -> proposal_redeemer [dir="none"];
    proposal_redeemer -> accept_project_operation [arrowsize="0.6"];
    input_global_data -> accept_project_operation [arrowsize="0.6"];
    input_project_instance -> accept_project_operation [arrowsize="0.6"];
    accept_project_operation -> output_active_project [arrowsize="0.6"];
    accept_project_operation -> output_creator_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, projectCreatorNFT";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}