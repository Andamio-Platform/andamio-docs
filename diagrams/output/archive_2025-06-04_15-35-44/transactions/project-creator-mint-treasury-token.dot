digraph ProjectCreatorMintTreasuryTokenTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">10.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_project_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project State UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: approved</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_status: uninitialized</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: project_creator_policy</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectInstance: (irt, project_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectPolicy: (prt, project_policy)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasuryPolicy: treasury_policy_config</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_project_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>ProjectInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_state_cs: projectStateTokens[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_config: default_treasury_config</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: project_creator_policy</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction node with embedded mint policy
    mint_treasury_operation [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#e8f5e8">
            <TR><TD ALIGN="center"><B><FONT POINT-SIZE="16">mint treasury
token</FONT></B></TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
            <TR><TD>
                <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#6A5ACD">
                    <TR><TD ALIGN="left" BGCOLOR="#f0f0ff"><B>TreasuryTokenMint</B></TD></TR>
                    <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryToken</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">Mint Treasury Token</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Params:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">treasuryConfig</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">initialBudget</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">project_creator_signature</FONT></TD></TR>
                </TABLE>
            </TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
        </TABLE>
    >, shape=box, style="filled", fillcolor="#e8f5e8", color="#00796b", fontname="Arial", fontsize=10, penwidth=3, margin="0.2,0.2"];

    // Output UTxO nodes
    output_treasury_utxo [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Treasury UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryToken</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1000.0 ADA</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">total_funds: initial_treasury_balance</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">reward_pool: reward_allocation</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_schedule: schedule_config</FONT></TD></TR>
        </TABLE>
    >];
    output_project_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Project State</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: treasury_initialized</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_status: active</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: project_creator_policy</FONT></TD></TR>
        </TABLE>
    >];
    output_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Project Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">6.5 ADA</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    project_state_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>TreasuryAction.ManageTreasury</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasuryConfig</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">initialBudget</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">rewardStructure</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_creator_wallet; input_project_state; input_global_data; input_project_instance;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_creator_wallet -> input_project_state [style=invis, weight=10];
    input_project_state -> input_global_data [style=invis, weight=10];
    input_global_data -> input_project_instance [style=invis, weight=10];
    {rank=same; project_state_redeemer;}
    {rank=same; mint_treasury_operation;}
    {rank=max; output_treasury_utxo; output_project_state; output_creator_wallet;}
    // Maintain output order from YAML
    output_treasury_utxo -> output_project_state [style=invis, weight=10];
    output_project_state -> output_creator_wallet [style=invis, weight=10];

    // Connections
    input_creator_wallet -> mint_treasury_operation [arrowsize="0.6"];
    input_project_state -> project_state_redeemer [dir="none"];
    project_state_redeemer -> mint_treasury_operation [arrowsize="0.6"];
    input_global_data -> mint_treasury_operation [arrowsize="0.6"];
    input_project_instance -> mint_treasury_operation [arrowsize="0.6"];
    mint_treasury_operation -> output_treasury_utxo [arrowsize="0.6"];
    mint_treasury_operation -> output_project_state [arrowsize="0.6"];
    mint_treasury_operation -> output_creator_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, projectCreatorNFT";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}