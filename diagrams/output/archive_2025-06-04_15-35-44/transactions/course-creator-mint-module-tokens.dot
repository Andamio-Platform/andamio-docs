digraph CourseCreatorMintModuleTokensTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Course Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 courseCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">10.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_course_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Course State UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_state_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 courseStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_id: course_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">modules: existing_module_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: course_creator_policy</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: active</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">courseInstance: (irt, course_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">coursePolicy: (prt, course_policy)[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_course_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>CourseInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_nft_cs: course_nft_cs</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: course_creator_policy</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">module_token_policy: module_minting_policy</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction node with embedded mint policy
    mint_modules_operation [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" BGCOLOR="#e8f5e8">
            <TR><TD ALIGN="center"><B><FONT POINT-SIZE="16">mint module
tokens</FONT></B></TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
            <TR><TD>
                <TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff" COLOR="#6A5ACD">
                    <TR><TD ALIGN="left" BGCOLOR="#f0f0ff"><B>ModuleTokenMint</B></TD></TR>
                    <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">5 moduleToken_1</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">5 moduleToken_2</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">5 moduleToken_3</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">Mint Module Tokens</FONT></TD></TR>
                    <TR><TD ALIGN="left"><B>Params:</B></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">moduleList</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">moduleContent</FONT></TD></TR>
                    <TR><TD ALIGN="left"><FONT FACE="Courier New">course_creator_signature</FONT></TD></TR>
                </TABLE>
            </TD></TR>
            <TR><TD HEIGHT="10"></TD></TR>
        </TABLE>
    >, shape=box, style="filled", fillcolor="#e8f5e8", color="#00796b", fontname="Arial", fontsize=10, penwidth=3, margin="0.2,0.2"];

    // Output UTxO nodes
    output_module_tokens [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Module Tokens</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">module_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5 moduleToken_1</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5 moduleToken_2</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5 moduleToken_3</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">module_info: module_specifications[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator: course_creator_alias</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_id: course_identifier</FONT></TD></TR>
        </TABLE>
    >];
    output_course_state [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Course State</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_state_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 courseStateToken</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">course_id: course_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">modules: updated_module_list[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">creator_policy: course_creator_policy</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">status: modules_available</FONT></TD></TR>
        </TABLE>
    >];
    output_creator_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Course Creator Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 courseCreatorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">6.5 ADA</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    course_state_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Add Modules</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">moduleList</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">moduleContent</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">assignmentStructure</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_creator_wallet; input_course_state; input_global_data; input_course_instance;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_creator_wallet -> input_course_state [style=invis, weight=10];
    input_course_state -> input_global_data [style=invis, weight=10];
    input_global_data -> input_course_instance [style=invis, weight=10];
    {rank=same; course_state_redeemer;}
    {rank=same; mint_modules_operation;}
    {rank=max; output_module_tokens; output_course_state; output_creator_wallet;}
    // Maintain output order from YAML
    output_module_tokens -> output_course_state [style=invis, weight=10];
    output_course_state -> output_creator_wallet [style=invis, weight=10];

    // Connections
    input_creator_wallet -> mint_modules_operation [arrowsize="0.6"];
    input_course_state -> course_state_redeemer [dir="none"];
    course_state_redeemer -> mint_modules_operation [arrowsize="0.6"];
    input_global_data -> mint_modules_operation [arrowsize="0.6"];
    input_course_instance -> mint_modules_operation [arrowsize="0.6"];
    mint_modules_operation -> output_module_tokens [arrowsize="0.6"];
    mint_modules_operation -> output_course_state [arrowsize="0.6"];
    mint_modules_operation -> output_creator_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, courseCreatorNFT";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}