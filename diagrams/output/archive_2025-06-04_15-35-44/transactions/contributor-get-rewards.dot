digraph ContributorGetRewardsTransaction {
    rankdir="LR";
    bgcolor="#ffffff";
    splines="ortho";
    nodesep=0.4;
    ranksep=0.8;

    // Default node style
    node [shape=box, style="filled", fillcolor="#ffffff", color="#4CAF50", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    edge [color="#000000", fontname="Arial", fontsize=9];

    // Input UTxO nodes
    input_contributor_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Contributor Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 contributorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 projectCompletionToken</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">5.0 ADA</FONT></TD></TR>
        </TABLE>
    >];
    input_treasury_utxo [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Treasury UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_scripts</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryToken</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1000.0 ADA</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">500 rewardTokens</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">total_funds: treasury_balance</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">pending_rewards: reward_queue[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_schedule: schedule_data</FONT></TD></TR>
        </TABLE>
    >];

    // Reference Input UTxO nodes (read only)
    input_global_data [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Global Data UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 prt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">projectInstance: (irt, project_instance)[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">rewardPolicy: reward_distribution_policy</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_project_instance [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>ProjectInstance UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 irt</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">treasury_config: treasury_parameters</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">reward_structure: reward_config</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">completion_criteria: criteria_list[]</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];
    input_completion_proof [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Completion Proof UTxO</B></TD></TR>
            <TR><TD ALIGN="left"><FONT COLOR="#2196F3"><B>read only</B></FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 proofToken</FONT></TD></TR>
            <TR><TD HEIGHT="5"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributor: contributor_alias</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">work_completed: completion_evidence</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">verification_status: verified</FONT></TD></TR>
        </TABLE>
    >, style="filled", fillcolor="#ffffff", color="#2196F3", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Transaction/Operation node
    claim_rewards_operation [label="claim project
rewards", shape=box, style="rounded, filled", fillcolor="#ffffff", color="#00796b", fontsize=12, penwidth=3, width=2, height=6];

    // Output UTxO nodes
    output_treasury_utxo [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Updated Treasury UTxO</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 treasuryToken</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">900.0 ADA</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">450 rewardTokens</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Datum:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">project_id: project_identifier</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">total_funds: updated_treasury_balance</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">pending_rewards: updated_reward_queue[]</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">payment_schedule: schedule_data</FONT></TD></TR>
        </TABLE>
    >];
    output_contributor_wallet [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>Contributor Wallet</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>            <TR><TD ALIGN="left"><B>Address:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">string</FONT></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Value:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">100at token</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">1 contributorNFT</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">50 rewardTokens</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">102.5 ADA</FONT></TD></TR>
        </TABLE>
    >];

    // Redeemer/Validator nodes
    node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    treasury_redeemer [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD ALIGN="left"><B>TreasuryAction.GetRewards</B></TD></TR>
            <TR><TD HEIGHT="3"></TD></TR>
            <TR><TD ALIGN="left"><B>Redeemer:</B></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">contributorAlias</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">completionProof</FONT></TD></TR>
            <TR><TD ALIGN="left"><FONT FACE="Courier New">rewardAmount</FONT></TD></TR>
        </TABLE>
    >, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#cc7000", fontname="Arial", fontsize=10, penwidth=2, margin="0.1,0.1"];

    // Automatic layout constraints for 4-column layout
    {rank=min; input_contributor_wallet; input_treasury_utxo; input_global_data; input_project_instance; input_completion_proof;}
    // Maintain input order from YAML (inputs first, then reference inputs)
    input_contributor_wallet -> input_treasury_utxo [style=invis, weight=10];
    input_treasury_utxo -> input_global_data [style=invis, weight=10];
    input_global_data -> input_project_instance [style=invis, weight=10];
    input_project_instance -> input_completion_proof [style=invis, weight=10];
    {rank=same; treasury_redeemer;}
    {rank=same; claim_rewards_operation;}
    {rank=max; output_treasury_utxo; output_contributor_wallet;}
    // Maintain output order from YAML
    output_treasury_utxo -> output_contributor_wallet [style=invis, weight=10];

    // Connections
    input_contributor_wallet -> claim_rewards_operation [arrowsize="0.6"];
    input_treasury_utxo -> treasury_redeemer [dir="none"];
    treasury_redeemer -> claim_rewards_operation [arrowsize="0.6"];
    input_global_data -> claim_rewards_operation [arrowsize="0.6"];
    input_project_instance -> claim_rewards_operation [arrowsize="0.6"];
    input_completion_proof -> claim_rewards_operation [arrowsize="0.6"];
    claim_rewards_operation -> output_treasury_utxo [arrowsize="0.6"];
    claim_rewards_operation -> output_contributor_wallet [arrowsize="0.6"];

    // Required tokens footer
    label="Required Tokens: 100at, contributorNFT, projectCompletionToken";
    labelloc="b";
    fontsize=10;
    fontcolor="#666666";
}