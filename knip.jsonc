{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "content-collections.ts",
    "content/docs/**/*.mdx",
    ".github/scripts/*.mjs",
    "scripts/ci/*.mjs"
  ],
  "project": [
    "**/*.{ts,tsx,js,mjs,mdx,css}",
    "!.claude/**"
  ],
  // Loaded by name through FlatCompat in eslint.config.mjs, which knip cannot trace.
  "ignoreDependencies": ["eslint-config-next"],
  "compilers": {
    "mdx": true
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
