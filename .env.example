# Andamio Documentation Site Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# API Configuration
# =============================================================================

# Andamio API Gateway URL (required for API proxy)
# Dev environment: https://dev-api.andamio.io
# Production: https://api.andamio.io (when available)
NEXT_PUBLIC_ANDAMIO_GATEWAY_URL="https://dev-api.andamio.io"

# Andamioscan Indexer URL (for on-chain data queries)
NEXT_PUBLIC_ANDAMIOSCAN_URL="https://preprod.andamioscan.io"

# =============================================================================
# Optional: For Andamio SDK Integration Examples
# =============================================================================

# Access Token Policy ID (for Pioneers/SDK examples)
# NEXT_PUBLIC_ACCESS_TOKEN_POLICY_ID="29aa6a65f5c890cfa428d59b15dec6293bf4ff0a94305c957508dc78"
