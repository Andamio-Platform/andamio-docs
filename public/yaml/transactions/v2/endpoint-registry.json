{
  "version": "0.1.0",
  "lastUpdated": "2025-12-08",
  "baseUrl": "https://atlas-api-preprod-507341199760.us-central1.run.app",
  "notes": [
    "TEMPORARY: Endpoint pattern will change from /tx/v2/{role}/{system}/{action} to /tx/v2/{system}/{role}/{action}",
    "Update the 'endpoint' field for each transaction when the API pattern changes"
  ],
  "urlPattern": {
    "current": "/tx/v2/{role}/{system}/{action}",
    "upcoming": "/tx/v2/{system}/{role}/{action}"
  },
  "commonTypes": {
    "Alias": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+$",
      "minLength": 1,
      "maxLength": 31,
      "description": "Alphanumeric identifier with underscores"
    },
    "GYMintingPolicyId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{56}$",
      "description": "56-character hex minting policy ID"
    },
    "CourseId": {
      "type": "GYMintingPolicyId",
      "description": "Course NFT policy ID - identifies a specific course"
    },
    "SltHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "64-character hex hash for SLT references"
    },
    "GYAddressBech32": {
      "type": "string",
      "description": "Cardano address in Bech32 format"
    },
    "WalletData": {
      "type": "object",
      "properties": {
        "usedAddresses": {
          "type": "array",
          "items": "GYAddressBech32"
        },
        "changeAddress": "GYAddressBech32"
      }
    }
  },
  "transactions": {
    "general.mint-access-token": {
      "role": "open",
      "system": "general",
      "action": "mint-access-token",
      "endpoint": "/tx/v2/general/mint-access-token",
      "method": "POST",
      "description": "Mint access tokens for protocol participation",
      "requestBody": "MintAccessTokenV2TxRequest",
      "request": {
        "walletData": {
          "type": "GYAddressBech32",
          "required": true
        },
        "alias": {
          "type": "Alias",
          "required": true
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        }
      }
    },
    "course.admin.create": {
      "role": "admin",
      "system": "course",
      "action": "create",
      "endpoint": "/tx/v2/admin/course/create",
      "method": "POST",
      "description": "Create a new course",
      "requestBody": "InitCourseV2TxRequest",
      "request": {
        "walletData": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "teachers": {
          "type": "array",
          "items": "Alias",
          "required": true,
          "description": "List of teacher aliases"
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        },
        "courseId": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "The created course's policy ID"
        }
      }
    },
    "course.admin.teachers-update": {
      "role": "admin",
      "system": "course",
      "action": "teachers/update",
      "endpoint": "/tx/v2/admin/course/teachers/update",
      "method": "POST",
      "description": "Manage course governance and teachers",
      "requestBody": "ManageCourseGovernanceTxRequest",
      "request": {
        "walletData": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "courseId": {
          "type": "GYMintingPolicyId",
          "required": true
        },
        "teachersToAdd": {
          "type": "array",
          "items": "Alias",
          "required": true
        },
        "teachersToRemove": {
          "type": "array",
          "items": "Alias",
          "required": true
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        }
      }
    },
    "course.teacher.modules-manage": {
      "role": "teacher",
      "system": "course",
      "action": "modules/manage",
      "endpoint": "/tx/v2/teacher/course/modules/manage",
      "method": "POST",
      "description": "Mint and manage course modules",
      "requestBody": "ManageModulesV2TxRequest",
      "request": {
        "walletData": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "courseId": {
          "type": "GYMintingPolicyId",
          "required": true
        },
        "modulesToMint": {
          "type": "array",
          "required": true,
          "items": {
            "type": "MintModuleV2",
            "properties": {
              "slts": {
                "type": "array",
                "items": "string",
                "required": true
              },
              "allowedStudents_V2": {
                "type": "array",
                "items": "GYMintingPolicyId",
                "required": true
              },
              "prerequisiteAssignments_V2": {
                "type": "array",
                "items": "SltHash",
                "required": true
              }
            }
          }
        },
        "modulesToUpdate": {
          "type": "array",
          "required": true,
          "items": {
            "type": "UpdateModuleV2",
            "properties": {
              "sltHash": {
                "type": "SltHash",
                "required": true
              },
              "allowedStudents_V2": {
                "type": "array",
                "items": "GYMintingPolicyId",
                "required": true
              },
              "prerequisiteAssignments_V2": {
                "type": "array",
                "items": "SltHash",
                "required": true
              }
            }
          }
        },
        "modulesToBurn": {
          "type": "array",
          "items": "SltHash",
          "required": true
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        }
      }
    },
    "course.teacher.assignments-assess": {
      "role": "teacher",
      "system": "course",
      "action": "assignments/assess",
      "endpoint": "/tx/v2/teacher/course/assignments/assess",
      "method": "POST",
      "description": "Assess and decide on student assignments",
      "requestBody": "DecideAssignmentV2TxRequest",
      "request": {
        "walletData": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "courseId": {
          "type": "GYMintingPolicyId",
          "required": true
        },
        "assignmentDecisions": {
          "type": "array",
          "required": true,
          "items": {
            "type": "AssignmentOutcome",
            "properties": {
              "outcome": {
                "type": "enum",
                "values": ["accept", "refuse"],
                "required": true
              },
              "alias": {
                "type": "Alias",
                "required": true,
                "description": "Student alias"
              }
            }
          }
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        }
      }
    },
    "course.student.assignment.commit": {
      "role": "student",
      "system": "course",
      "action": "assignment/commit",
      "endpoint": "/v2/tx/course/student/assignment/commit",
      "method": "POST",
      "description": "Enroll in a course (if not enrolled) and commit to an assignment. Replaces the old enroll endpoint - commitment is now required.",
      "requestBody": "EnrollCourseTxRequest",
      "request": {
        "initiator_data": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "course_id": {
          "type": "GYMintingPolicyId",
          "required": true
        },
        "slt_hash": {
          "type": "SltHash",
          "required": true,
          "description": "Module token hash to commit to"
        },
        "assignment_info": {
          "type": "string",
          "required": true,
          "description": "Evidence hash for the assignment"
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      },
      "deprecates": "course.student.enroll"
    },
    "course.student.assignment-update": {
      "role": "student",
      "system": "course",
      "action": "assignment/update",
      "endpoint": "/tx/v2/student/course/assignment/update",
      "method": "POST",
      "description": "Commit to or update an assignment",
      "requestBody": "AssignmentActionV2TxRequest",
      "request": {
        "walletData": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "courseId": {
          "type": "GYMintingPolicyId",
          "required": true
        },
        "assignmentInfo": {
          "type": "string",
          "required": true
        },
        "maybeNewSltHash": {
          "type": "SltHash",
          "required": false,
          "description": "Optional new SLT to commit to"
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        }
      }
    },
    "course.student.credential-claim": {
      "role": "student",
      "system": "course",
      "action": "credential/claim",
      "endpoint": "/tx/v2/student/course/credential/claim",
      "method": "POST",
      "description": "Claim credential by burning course state",
      "requestBody": "BurnCourseStateV2TxRequest",
      "request": {
        "walletData": {
          "type": "WalletData",
          "required": false
        },
        "alias": {
          "type": "Alias",
          "required": true
        },
        "courseId": {
          "type": "GYMintingPolicyId",
          "required": true
        }
      },
      "response": {
        "unsignedTxCBOR": {
          "type": "string",
          "required": true
        }
      }
    },
    "instance.owner.project.create": {
      "role": "owner",
      "system": "instance",
      "action": "project/create",
      "endpoint": "/v2/tx/instance/owner/project/create",
      "method": "POST",
      "description": "Create a new project with treasury, managers, and optional course prerequisites",
      "requestBody": "CreateProjectTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Owner's access token alias"
        },
        "managers": {
          "type": "array",
          "items": "Alias",
          "required": true,
          "description": "List of manager aliases"
        },
        "course_prereqs": {
          "type": "array",
          "items": "[GYMintingPolicyId, [SltHash]]",
          "required": true,
          "description": "Course prerequisite requirements: [[course_id, [module_hashes]]]"
        },
        "deposit_value": {
          "type": "array",
          "items": "[asset_unit, amount]",
          "required": true,
          "description": "Initial treasury deposit as [[unit, amount]] pairs. Empty = no deposit."
        },
        "initiator_data": {
          "type": "WalletData",
          "required": false
        }
      },
      "response": {
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID - THIS IS the projectId"
        },
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      }
    },
    "project.owner.managers.manage": {
      "role": "owner",
      "system": "project",
      "action": "managers/manage",
      "endpoint": "/v2/tx/project/owner/managers/manage",
      "method": "POST",
      "description": "Add or remove managers from a project by updating the governance UTxO",
      "requestBody": "ManageManagersTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Owner's access token alias"
        },
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID (56 char hex)"
        },
        "managers_to_add": {
          "type": "array",
          "items": "Alias",
          "required": true,
          "description": "List of manager aliases to add"
        },
        "managers_to_remove": {
          "type": "array",
          "items": "Alias",
          "required": true,
          "description": "List of manager aliases to remove"
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      }
    },
    "project.owner.contributor-blacklist.manage": {
      "role": "owner",
      "system": "project",
      "action": "contributor-blacklist/manage",
      "endpoint": "/v2/tx/project/owner/contributor-blacklist/manage",
      "method": "POST",
      "description": "Add or remove contributors from a project's blacklist",
      "requestBody": "ManageContributorBlacklistTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Owner's access token alias"
        },
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID (56 char hex)"
        },
        "aliases_to_add": {
          "type": "array",
          "items": "Alias",
          "required": true,
          "description": "List of contributor aliases to add to blacklist"
        },
        "aliases_to_remove": {
          "type": "array",
          "items": "Alias",
          "required": true,
          "description": "List of contributor aliases to remove from blacklist"
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      },
      "notes": "No protocol fee charged for blacklist management"
    },
    "project.manager.tasks.manage": {
      "role": "manager",
      "system": "project",
      "action": "tasks/manage",
      "endpoint": "/v2/tx/project/manager/tasks/manage",
      "method": "POST",
      "description": "Add or remove project tasks, optionally fund treasury",
      "requestBody": "ManageTasksTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Manager's access token alias"
        },
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID (56 char hex)"
        },
        "contributor_state_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Prerequisite credential policy ID - contributors must hold token from this policy"
        },
        "tasks_to_add": {
          "type": "array",
          "required": true,
          "items": {
            "type": "TaskDefinition",
            "properties": {
              "project_content": {
                "type": "string",
                "required": true,
                "description": "Task content hash or identifier"
              },
              "expiration_time": {
                "type": "integer",
                "required": true,
                "description": "Expiration timestamp in milliseconds"
              },
              "lovelace_amount": {
                "type": "integer",
                "required": true,
                "description": "ADA reward in lovelace"
              },
              "native_assets": {
                "type": "array",
                "required": true,
                "description": "Additional token rewards (never includes lovelace)"
              }
            }
          },
          "description": "Tasks to create"
        },
        "tasks_to_remove": {
          "type": "array",
          "required": true,
          "description": "Tasks to remove (must match existing task parameters)"
        },
        "deposit_value": {
          "type": "array",
          "required": false,
          "description": "Optional treasury deposit as [[unit, amount]] pairs"
        },
        "aliases_to_remove": {
          "type": "array",
          "required": false,
          "description": "IGNORED - not used"
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      },
      "notes": "No minting occurs - uses existing treasury-tokens from project.create"
    },
    "project.contributor.task.commit": {
      "role": "contributor",
      "system": "project",
      "action": "task/commit",
      "endpoint": "/v2/tx/project/contributor/task/commit",
      "method": "POST",
      "description": "Enroll in a project (if not enrolled) and commit to a task",
      "requestBody": "TaskCommitTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Contributor's access token alias"
        },
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID (56 char hex)"
        },
        "contributor_state_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Contributor state policy ID (from project prerequisites)"
        },
        "task_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "required": true,
          "description": "Hash of the task to commit to (64 char hex)"
        },
        "task_info": {
          "type": "string",
          "required": true,
          "description": "Evidence/info for the task submission"
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      },
      "notes": "MINTS contributor-state token on first enrollment. Combines enrollment + task commitment in a single transaction. Similar pattern to course.student.assignment.commit."
    },
    "project.manager.tasks.assess": {
      "role": "manager",
      "system": "project",
      "action": "tasks/assess",
      "endpoint": "/v2/tx/project/manager/tasks/assess",
      "method": "POST",
      "description": "Assess contributor task submissions (accept/reject)",
      "requestBody": "TasksAssessTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Manager's access token alias"
        },
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID (56 char hex)"
        },
        "contributor_state_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Contributor state policy ID"
        },
        "task_decisions": {
          "type": "array",
          "required": true,
          "description": "List of assessment decisions",
          "items": {
            "type": "TaskDecision",
            "properties": {
              "alias": {
                "type": "Alias",
                "required": true,
                "description": "Contributor alias being assessed"
              },
              "outcome": {
                "type": "enum",
                "values": ["accept", "reject"],
                "required": true,
                "description": "Assessment outcome"
              }
            }
          }
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      },
      "notes": "No minting - spend and recreate pattern. Similar to course.teacher.assignments.assess. Supports batching multiple decisions."
    },
    "project.contributor.credential.claim": {
      "role": "contributor",
      "system": "project",
      "action": "credential/claim",
      "endpoint": "/v2/tx/project/contributor/credential/claim",
      "method": "POST",
      "description": "Claim project credential by burning contributor state token",
      "requestBody": "CredentialClaimTxRequest",
      "request": {
        "alias": {
          "type": "Alias",
          "required": true,
          "description": "Contributor's access token alias"
        },
        "project_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Project NFT policy ID (56 char hex)"
        },
        "contributor_state_id": {
          "type": "GYMintingPolicyId",
          "required": true,
          "description": "Contributor state policy ID"
        }
      },
      "response": {
        "unsigned_tx": {
          "type": "string",
          "required": true
        }
      },
      "notes": "BURNS contributor-state token. 1 ADA protocol fee. Contributor gets NET GAIN from released deposit. Credential hash stored in global state."
    }
  }
}
